-- ═══════════════════════════════════════════════════════════════════
-- Natural-number arithmetic, proved by induction inside Epsilon.
-- Every theorem here is checked by the trusted kernel: ✓ Formally Proven.
-- ═══════════════════════════════════════════════════════════════════

/-- Zero is a right identity (definitional). -/
theorem add_zero' (a : Nat) : a + 0 = a := by rfl

/-- Zero is a left identity — needs induction, since 0 + a does not reduce. -/
theorem zero_add' (a : Nat) : 0 + a = a := by
  induction a with
  | zero => rfl
  | succ n ih => rw [Nat.add_succ, ih]

/-- Addition is commutative. -/
theorem my_add_comm (a b : Nat) : a + b = b + a := by
  induction b with
  | zero => rw [Nat.add_zero, Nat.zero_add]
  | succ n ih => rw [Nat.add_succ, Nat.succ_add, ih]

/-- Addition is associative. -/
theorem my_add_assoc (a b c : Nat) : (a + b) + c = a + (b + c) := by
  induction c with
  | zero => rfl
  | succ n ih => rw [Nat.add_succ, Nat.add_succ, Nat.add_succ, ih]

/-- Multiplication distributes over addition on the left. -/
theorem my_distrib (a b c : Nat) : a * (b + c) = a * b + a * c := by
  induction c with
  | zero => rfl
  | succ n ih => rw [Nat.add_succ, Nat.mul_succ, ih, Nat.mul_succ, Nat.add_assoc]

/-- A concrete computation, decided by the kernel's literal arithmetic. -/
theorem two_plus_two : 2 + 2 = 4 := by rfl

theorem factorial_fact : 3 * 2 * 1 = 6 := by rfl

/-- An order fact, decided by computation. -/
theorem seven_le_ten : 7 ≤ 10 := by decide

-- Evaluate arithmetic directly:
#eval 2 + 3 * 4
#eval 2 ^ 10
#eval (100 - 58) * 2

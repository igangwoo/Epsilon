{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m pip install --quiet build && python3 -m build --wheel && cp dist/epsilon_math-*.whl web/",
  "outputDirectory": "web",
  "framework": null,
  "installCommand": "true",
  "headers": [
    {
      "source": "/(.*\\.whl)",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

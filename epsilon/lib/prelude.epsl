-- Epsilon standard library · prelude
-- Loaded automatically into every session.
-- Everything here is checked by the kernel on load; theorems below are
-- Formally Proven (relative only to the axioms they list).
-- ═══════════════════════════════════════════════════════════════════

-- ── type aliases (unicode mathematics) ──────────────────────────────
def ℕ : Type := Nat
def ℤ : Type := Int
def ℚ : Type := Rat
def ℝ : Type := Real
def ℂ : Type := Complex

def ⊤ : Prop := True
def ⊥ : Prop := False

-- ── real-function shorthands ────────────────────────────────────────
def sin : ℝ → ℝ := Real.sin
def cos : ℝ → ℝ := Real.cos
def tan : ℝ → ℝ := Real.tan
def asin : ℝ → ℝ := Real.asin
def acos : ℝ → ℝ := Real.acos
def atan : ℝ → ℝ := Real.atan
def sinh : ℝ → ℝ := Real.sinh
def cosh : ℝ → ℝ := Real.cosh
def tanh : ℝ → ℝ := Real.tanh
def exp : ℝ → ℝ := Real.exp
def log : ℝ → ℝ := Real.log
def ln : ℝ → ℝ := Real.log
def sqrt : ℝ → ℝ := Real.sqrt
def abs : ℝ → ℝ := Real.abs
def π : ℝ := Real.pi

-- ── basic logic ─────────────────────────────────────────────────────

/-- Symmetry of equality. -/
@[name "Equality.Symmetry"]
theorem Eq.symm {A : Type} {a b : A} (h : a = b) : b = a := by
  symm
  exact h

/-- Transitivity of equality. -/
@[name "Equality.Transitivity"]
theorem Eq.trans {A : Type} {a b c : A} (h1 : a = b) (h2 : b = c) : a = c := by
  rw [h1]
  exact h2

/-- Congruence: applying a function preserves equality. -/
@[name "Equality.Congruence"]
theorem congrArg {A : Type} {B : Type} (f : A → B) {a b : A}
    (h : a = b) : f(a) = f(b) := by
  rw [h]

@[name "Conjunction.LeftProjection"]
theorem And.left {p q : Prop} (h : p ∧ q) : p := by
  cases h with
  | intro hp hq => exact hp

@[name "Conjunction.RightProjection"]
theorem And.right {p q : Prop} (h : p ∧ q) : q := by
  cases h with
  | intro hp hq => exact hq

@[name "Equivalence.ForwardDirection"]
theorem Iff.mp {p q : Prop} (h : p ↔ q) (hp : p) : q := by
  cases h with
  | intro f g => exact f(hp)

@[name "Equivalence.BackwardDirection"]
theorem Iff.mpr {p q : Prop} (h : p ↔ q) (hq : q) : p := by
  cases h with
  | intro f g => exact g(hq)

@[name "Logic.Absurdity"]
theorem absurd {p q : Prop} (hp : p) (hnp : ¬p) : q := by
  contradiction

@[name "Negation.DoubleNegationIntroduction"]
theorem not_not_intro {p : Prop} (hp : p) : ¬¬p := by
  intro hnp
  contradiction

@[name "Logic.ModusTollens"]
theorem modus_tollens {p q : Prop} (h : p → q) (hnq : ¬q) : ¬p := by
  intro hp
  apply hnq
  apply h
  exact hp

-- ── classical logic (tracked axiom) ─────────────────────────────────

/-- Law of excluded middle. Theorems that use this list it explicitly. -/
@[name "Classical.ExcludedMiddle"]
axiom Classical.em (p : Prop) : p ∨ ¬p

@[name "Classical.ProofByContradiction"]
theorem Classical.byContradiction {p : Prop} (h : ¬p → False) : p := by
  cases Classical.em(p) with
  | inl hp => exact hp
  | inr hnp =>
    exfalso
    exact h(hnp)

@[name "Classical.DoubleNegationElimination"]
theorem Classical.not_not {p : Prop} (h : ¬¬p) : p := by
  cases Classical.em(p) with
  | inl hp => exact hp
  | inr hnp => contradiction

-- ── natural number arithmetic ───────────────────────────────────────

namespace Nat

@[simp, name "NaturalNumbers.Addition.RightIdentity"]
theorem add_zero (a : ℕ) : a + 0 = a := by rfl

@[name "NaturalNumbers.Addition.SuccessorOnRight"]
theorem add_succ (a b : ℕ) : a + Nat.succ(b) = Nat.succ(a + b) := by rfl

@[simp, name "NaturalNumbers.Addition.LeftIdentity"]
theorem zero_add (a : ℕ) : 0 + a = a := by
  induction a with
  | zero => rfl
  | succ n ih => rw [add_succ, ih]

@[name "NaturalNumbers.Addition.SuccessorOnLeft"]
theorem succ_add (a b : ℕ) : Nat.succ(a) + b = Nat.succ(a + b) := by
  induction b with
  | zero => rfl
  | succ n ih => rw [add_succ, ih, add_succ]

/-- Commutativity of addition on ℕ, proved by induction. -/
@[name "NaturalNumbers.Addition.Commutativity"]
theorem add_comm (a b : ℕ) : a + b = b + a := by
  induction b with
  | zero => rw [add_zero, zero_add]
  | succ n ih => rw [add_succ, succ_add, ih]

/-- Associativity of addition on ℕ. -/
@[name "NaturalNumbers.Addition.Associativity"]
theorem add_assoc (a b c : ℕ) : (a + b) + c = a + (b + c) := by
  induction c with
  | zero => rfl
  | succ n ih => rw [add_succ, add_succ, add_succ, ih]

@[simp, name "NaturalNumbers.Multiplication.RightZero"]
theorem mul_zero (a : ℕ) : a * 0 = 0 := by rfl

@[name "NaturalNumbers.Multiplication.SuccessorOnRight"]
theorem mul_succ (a b : ℕ) : a * Nat.succ(b) = a * b + a := by rfl

@[simp, name "NaturalNumbers.Multiplication.LeftZero"]
theorem zero_mul (a : ℕ) : 0 * a = 0 := by
  induction a with
  | zero => rfl
  | succ n ih => rw [mul_succ, ih, add_zero]

@[simp, name "NaturalNumbers.Multiplication.RightIdentity"]
theorem mul_one (a : ℕ) : a * 1 = a := by
  rw [mul_succ, mul_zero, zero_add]

@[simp, name "NaturalNumbers.Multiplication.LeftIdentity"]
theorem one_mul (a : ℕ) : 1 * a = a := by
  induction a with
  | zero => rfl
  | succ n ih => rw [mul_succ, ih, add_succ, add_zero]

@[name "NaturalNumbers.Multiplication.SuccessorOnLeft"]
theorem succ_mul (a b : ℕ) : Nat.succ(a) * b = a * b + b := by
  induction b with
  | zero => rfl
  | succ n ih =>
    rw [mul_succ, ih, mul_succ]
    rw [add_succ, add_succ, add_assoc, add_assoc, add_comm n a]

/-- Commutativity of multiplication on ℕ. -/
@[name "NaturalNumbers.Multiplication.Commutativity"]
theorem mul_comm (a b : ℕ) : a * b = b * a := by
  induction b with
  | zero => rw [mul_zero, zero_mul]
  | succ n ih => rw [mul_succ, succ_mul, ih]

/-- Left distributivity: a * (b + c) = a * b + a * c. -/
@[name "NaturalNumbers.Multiplication.DistributivityOverAddition"]
theorem left_distrib (a b c : ℕ) : a * (b + c) = a * b + a * c := by
  induction c with
  | zero => rfl
  | succ n ih =>
    rw [add_succ, mul_succ, ih, mul_succ, add_assoc]

@[simp, name "NaturalNumbers.Power.ZeroExponent"]
theorem pow_zero (a : ℕ) : a ^ 0 = 1 := by rfl

@[name "NaturalNumbers.Power.SuccessorExponent"]
theorem pow_succ (a b : ℕ) : a ^ Nat.succ(b) = a ^ b * a := by rfl

@[name "NaturalNumbers.Order.Reflexivity"]
theorem le_refl (a : ℕ) : a ≤ a := by
  exists 0

@[name "NaturalNumbers.Order.Transitivity"]
theorem le_trans {a b c : ℕ} (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c := by
  cases h1 with
  | intro d hd =>
    cases h2 with
    | intro e he =>
      exists d + e
      rw [← add_assoc, hd, he]

@[name "NaturalNumbers.Order.LessThanSuccessor"]
theorem le_succ (a : ℕ) : a ≤ Nat.succ(a) := by
  exists 1

@[name "NaturalNumbers.Order.LessThanSumOnRight"]
theorem le_add_right (a b : ℕ) : a ≤ a + b := by
  exists b

end Nat

-- ── decidability bridges for ordered fields (tracked axioms) ────────

axiom Int.le_of_ble (a b : ℤ) : Int.ble(a, b) = Bool.true → a ≤ b
axiom Int.lt_of_blt (a b : ℤ) : Int.blt(a, b) = Bool.true → a < b
axiom Rat.le_of_ble (a b : ℚ) : Rat.ble(a, b) = Bool.true → a ≤ b
axiom Rat.lt_of_blt (a b : ℚ) : Rat.blt(a, b) = Bool.true → a < b
axiom Real.le_of_ble (a b : ℝ) : Real.ble(a, b) = Bool.true → a ≤ b
axiom Real.lt_of_blt (a b : ℝ) : Real.blt(a, b) = Bool.true → a < b

import algebra
import analysis
import sets

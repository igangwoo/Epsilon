-- ═══════════════════════════════════════════════════════════════════
-- Epsilon standard library · algebra
-- Axiomatic algebraic structure of ℤ, ℚ, ℝ (commutative ordered fields).
-- ℝ is axiomatized (its construction is future work); every theorem
-- depending on these axioms lists them in its axiom report.
-- ═══════════════════════════════════════════════════════════════════

namespace Real

@[name "RealNumbers.Addition.Commutativity"]
axiom add_comm (a b : ℝ) : a + b = b + a
@[name "RealNumbers.Addition.Associativity"]
axiom add_assoc (a b c : ℝ) : (a + b) + c = a + (b + c)
@[simp, name "RealNumbers.Addition.RightIdentity"] axiom add_zero (a : ℝ) : a + 0 = a
@[simp, name "RealNumbers.Addition.LeftIdentity"] axiom zero_add (a : ℝ) : 0 + a = a
@[simp, name "RealNumbers.Addition.InverseElement"] axiom add_neg (a : ℝ) : a + (-a) = 0
@[name "RealNumbers.Multiplication.Commutativity"]
axiom mul_comm (a b : ℝ) : a * b = b * a
@[name "RealNumbers.Multiplication.Associativity"]
axiom mul_assoc (a b c : ℝ) : (a * b) * c = a * (b * c)
@[simp, name "RealNumbers.Multiplication.RightIdentity"] axiom mul_one (a : ℝ) : a * 1 = a
@[simp, name "RealNumbers.Multiplication.LeftIdentity"] axiom one_mul (a : ℝ) : 1 * a = a
@[simp, name "RealNumbers.Multiplication.RightZero"] axiom mul_zero (a : ℝ) : a * 0 = 0
@[simp, name "RealNumbers.Multiplication.LeftZero"] axiom zero_mul (a : ℝ) : 0 * a = 0
@[name "RealNumbers.Multiplication.LeftDistributivity"]
axiom left_distrib (a b c : ℝ) : a * (b + c) = a * b + a * c
@[name "RealNumbers.Multiplication.RightDistributivity"]
axiom right_distrib (a b c : ℝ) : (a + b) * c = a * c + b * c
@[name "RealNumbers.Subtraction.Definition"]
axiom sub_def (a b : ℝ) : a - b = a + (-b)
@[name "RealNumbers.Division.Definition"]
axiom div_def (a b : ℝ) : a / b = a * Real.inv(b)
@[name "RealNumbers.Multiplication.InverseElement"]
axiom mul_inv_cancel (a : ℝ) : a ≠ 0 → a * Real.inv(a) = 1
@[name "RealNumbers.Negation.Involution"]
axiom neg_neg (a : ℝ) : -(-a) = a

@[name "RealNumbers.Order.Reflexivity"]
axiom le_refl (a : ℝ) : a ≤ a
@[name "RealNumbers.Order.Transitivity"]
axiom le_trans (a b c : ℝ) : a ≤ b → b ≤ c → a ≤ c
@[name "RealNumbers.Order.Antisymmetry"]
axiom le_antisymm (a b : ℝ) : a ≤ b → b ≤ a → a = b
@[name "RealNumbers.Order.StrictIrreflexivity"]
axiom lt_irrefl (a : ℝ) : ¬(a < a)
@[name "RealNumbers.Order.Totality"]
axiom le_total (a b : ℝ) : a ≤ b ∨ b ≤ a
@[name "RealNumbers.Order.AdditionPreservesOrder"]
axiom add_le_add_right (a b c : ℝ) : a ≤ b → a + c ≤ b + c
@[name "RealNumbers.Order.MultiplicationPreservesOrder"]
axiom mul_le_mul_of_nonneg (a b c : ℝ) : a ≤ b → 0 ≤ c → a * c ≤ b * c
@[name "RealNumbers.Order.StrictFromDistinct"]
axiom lt_of_le_of_ne (a b : ℝ) : a ≤ b → a ≠ b → a < b
@[name "RealNumbers.Order.WeakFromStrict"]
axiom le_of_lt (a b : ℝ) : a < b → a ≤ b

@[name "RealNumbers.Square.Nonnegativity"]
axiom sq_nonneg (a : ℝ) : 0 ≤ a * a
@[name "RealNumbers.AbsoluteValue.Nonnegativity"]
axiom abs_nonneg (a : ℝ) : 0 ≤ Real.abs(a)
@[name "RealNumbers.SquareRoot.Nonnegativity"]
axiom sqrt_nonneg (a : ℝ) : 0 ≤ Real.sqrt(a)
@[name "RealNumbers.SquareRoot.OfSquare"]
axiom sqrt_sq (a : ℝ) : 0 ≤ a → Real.sqrt(a * a) = a

-- example derived result (Formally Proven relative to the field axioms)

@[name "RealNumbers.Addition.CommutativityOfThreeTerms"]
theorem add_comm_three (a b c : ℝ) : a + b + c = c + b + a := by
  rw [add_comm, add_comm a b]
  rw [← add_assoc]

end Real

namespace Int
@[name "Integers.Addition.Commutativity"]
axiom add_comm (a b : ℤ) : a + b = b + a
@[name "Integers.Addition.Associativity"]
axiom add_assoc (a b c : ℤ) : (a + b) + c = a + (b + c)
@[simp, name "Integers.Addition.RightIdentity"] axiom add_zero (a : ℤ) : a + 0 = a
@[simp, name "Integers.Addition.LeftIdentity"] axiom zero_add (a : ℤ) : 0 + a = a
@[simp, name "Integers.Addition.InverseElement"] axiom add_neg (a : ℤ) : a + (-a) = 0
@[name "Integers.Multiplication.Commutativity"]
axiom mul_comm (a b : ℤ) : a * b = b * a
@[name "Integers.Multiplication.Associativity"]
axiom mul_assoc (a b c : ℤ) : (a * b) * c = a * (b * c)
@[simp, name "Integers.Multiplication.RightIdentity"] axiom mul_one (a : ℤ) : a * 1 = a
@[name "Integers.Multiplication.DistributivityOverAddition"]
axiom left_distrib (a b c : ℤ) : a * (b + c) = a * b + a * c
end Int

namespace Rat
@[name "Rationals.Addition.Commutativity"]
axiom add_comm (a b : ℚ) : a + b = b + a
@[name "Rationals.Addition.Associativity"]
axiom add_assoc (a b c : ℚ) : (a + b) + c = a + (b + c)
@[simp, name "Rationals.Addition.RightIdentity"] axiom add_zero (a : ℚ) : a + 0 = a
@[name "Rationals.Multiplication.Commutativity"]
axiom mul_comm (a b : ℚ) : a * b = b * a
@[name "Rationals.Multiplication.Associativity"]
axiom mul_assoc (a b c : ℚ) : (a * b) * c = a * (b * c)
@[simp, name "Rationals.Multiplication.RightIdentity"] axiom mul_one (a : ℚ) : a * 1 = a
@[name "Rationals.Multiplication.DistributivityOverAddition"]
axiom left_distrib (a b c : ℚ) : a * (b + c) = a * b + a * c
end Rat
